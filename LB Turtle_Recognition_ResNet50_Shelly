orma: Linux-6.6.97+-x86_64-with-glibc2.35\n","CUDA disponible: False\n"]}],"source":["\n","# =====================================\n","# 1) CONFIGURACIÓN DE ENTORNO\n","# =====================================\n","import sys, os, platform\n","\n","print(\"Python:\", sys.version)\n","print(\"Plataforma:\", platform.platform())\n","\n","# ¿GPU?\n","import torch\n","print(\"CUDA disponible:\", torch.cuda.is_available())\n","if torch.cuda.is_available():\n","    print(\"GPU:\", torch.cuda.get_device_name(0))\n","\n","# Instalar dependencias clave (solo si faltan)\n","!pip -q install --upgrade torch torchvision --index-url https://download.pytorch.org/whl/cu121\n","!pip -q install transformers huggingface_hub opencv-python pillow matplotlib\n"]},{"cell_type":"markdown","id":"91b8847d","metadata":{"id":"91b8847d"},"source":["\n","## 2) Carga del dataset (`images/`)\n","Elige **una** de las dos opciones siguientes:\n","- **A)** Montar Google Drive y apuntar a la carpeta donde tengas `images/`\n","- **B)** Subir la carpeta `images` comprimida (`.zip`) y descomprimirla aquí\n"]},{"cell_type":"code","execution_count":null,"id":"60d4f016","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"60d4f016","executionInfo":{"status":"ok","timestamp":1758732298904,"user_tz":300,"elapsed":49376,"user":{"displayName":"Luis Barahona","userId":"18006082132771143363"}},"outputId":"69730959-1462-4748-a207-831b0cd07d55"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n",">>> Define DATASET_PATH con la ruta a tu carpeta 'images' en Drive, por ejemplo:\n",">>> DATASET_PATH = '/content/drive/MyDrive/tortugas/images'\n"]}],"source":["\n","# =====================================\n","# 2A) MONTAJE DE GOOGLE DRIVE (OPCIONAL, RECOMENDADO)\n","# =====================================\n","USE_DRIVE = True  # Cambia a False si subirás un zip manualmente en 2B\n","\n","DATASET_PATH = \"\"  # EJEMPLO: \"/content/drive/MyDrive/tortugas/images\"\n","\n","if USE_DRIVE:\n","    from google.colab import drive\n","    drive.mount('/content/drive')\n","    if DATASET_PATH.strip() == \"\":\n","        print(\">>> Define DATASET_PATH con la ruta a tu carpeta 'images' en Drive, por ejemplo:\")\n","        print(\">>> DATASET_PATH = '/content/drive/MyDrive/tortugas/images'\")\n","    else:\n","        print(\"Usando dataset en:\", DATASET_PATH)\n"]},{"cell_type":"code","execution_count":null,"id":"d4416652","metadata":{"id":"d4416652"},"outputs":[],"source":["\n","# =====================================\n","# 2B) SUBIR ZIP LOCALMENTE (ALTERNATIVA)\n","# =====================================\n","# Si no usas Drive, sube un zip que contenga la carpeta 'images' (estructura interna: images/CLASE/archivos)\n","# y descomprímelo aquí.\n","USE_UPLOAD = False  # Cambia a True si usarás esta opción\n","\n","if not 'DATASET_PATH' in globals():\n","    DATASET_PATH = \"\"\n","\n","if USE_UPLOAD and not USE_DRIVE:\n","    from google.colab import files\n","    up = files.upload()  # selecciona tu .zip\n","    # Detectar nombre del zip subido\n","    zip_names = list(up.keys())\n","    if len(zip_names) == 0:\n","        raise ValueError(\"No se subió ningún archivo.\")\n","    zip_name = zip_names[0]\n","    print(\"Zip subido:\", zip_name)\n","\n","    # Descomprimir\n","    import zipfile\n","    with zipfile.ZipFile(zip_name, 'r') as zf:\n","        zf.extractall(\".\")\n","    # Ajusta aquí si el zip deja la carpeta images directamente o dentro de otra\n","    # Por defecto, asumimos que ahora existe ./images\n","    DATASET_PATH = \"./images\"\n","    print(\"DATASET_PATH:\", DATASET_PATH)\n"]},{"cell_type":"code","execution_count":null,"id":"c9a23746","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"c9a23746","executionInfo":{"status":"ok","timestamp":1758732316728,"user_tz":300,"elapsed":17,"user":{"displayName":"Luis Barahona","userId":"18006082132771143363"}},"outputId":"5475cfb4-375a-4e0d-a558-41af4e5e1dd0"},"outputs":[{"output_type":"stream","name":"stdout","text":["⚠️  Aún no se ha definido DATASET_PATH. Configura 2A o 2B.\n"]}],"source":["\n","# =====================================\n","# VALIDACIÓN DE RUTA DEL DATASET\n","# =====================================\n","import os\n","\n","if DATASET_PATH.strip() == \"\":\n","    print(\"⚠️  Aún no se ha definido DATASET_PATH. Configura 2A o 2B.\")\n","else:\n","    if not os.path.isdir(DATASET_PATH):\n","        raise FileNotFoundError(f\"No existe la ruta: {DATASET_PATH}\")\n","    # Esperamos subcarpetas por clase\n","    subdirs = [d for d in os.listdir(DATASET_PATH) if os.path.isdir(os.path.join(DATASET_PATH, d))]\n","    print(f\"Rama: {DATASET_PATH}\")\n","    print(\"Subcarpetas/clases encontradas (muestra):\", subdirs[:10])\n","    print(\"Total de clases:\", len(subdirs))\n"]},{"cell_type":"markdown","id":"45751957","metadata":{"id":"45751957"},"source":["\n","## 3) Exploración rápida\n","Muestra una imagen de ejemplo por clase (o aleatoria) para verificar que la estructura esté correcta.\n"]},{"cell_type":"code","execution_count":null,"id":"cde7265c","metadata":{"id":"cde7265c"},"outputs":[],"source":["\n","import random\n","from PIL import Image\n","import matplotlib.pyplot as plt\n","\n","if DATASET_PATH.strip() != \"\":\n","    classes = [d for d in os.listdir(DATASET_PATH) if os.path.isdir(os.path.join(DATASET_PATH, d))]\n","    if len(classes) == 0:\n","        print(\"No se hallaron subcarpetas de clase dentro de 'images'. Revisa tu estructura.\")\n","    else:\n","        sample_class = random.choice(classes)\n","        class_path = os.path.join(DATASET_PATH, sample_class)\n","        imgs = [f for f in os.listdir(class_path) if f.lower().endswith(('.jpg','.jpeg','.png','.bmp'))]\n","        if len(imgs) == 0:\n","            print(f\"La clase {sample_class} no tiene imágenes. Revisa.\")\n","        else:\n","            sample_img = random.choice(imgs)\n","            p = os.path.join(class_path, sample_img)\n","            img = Image.open(p).convert(\"RGB\")\n","            plt.imshow(img); plt.axis('off'); plt.title(f\"Clase: {sample_class}\")\n","            plt.show()\n"]},{"cell_type":"markdown","id":"d3b75ede","metadata":{"id":"d3b75ede"},"source":["\n","## 4) Pipeline de datos (transformaciones y DataLoader)\n","Usamos `torchvision.datasets.ImageFolder`, que espera `images/CLASE/*.jpg`.  \n","Ajusta `BATCH_SIZE` y el tamaño de imagen según tu GPU.\n"]},{"cell_type":"code","execution_count":null,"id":"525e7413","metadata":{"id":"525e7413"},"outputs":[],"source":["\n","import torch\n","from torchvision import datasets, transforms\n","from torch.utils.data import DataLoader, random_split\n","\n","IMG_SIZE = 224\n","BATCH_SIZE = 16\n","VAL_SPLIT = 0.15\n","SEED = 42\n","\n","if DATASET_PATH.strip() != \"\":\n","    transform = transforms.Compose([\n","        transforms.Resize((IMG_SIZE, IMG_SIZE)),\n","        transforms.ToTensor(),\n","        transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])\n","    ])\n","\n","    full_ds = datasets.ImageFolder(DATASET_PATH, transform=transform)\n","    num_val = int(len(full_ds) * VAL_SPLIT)\n","    num_train = len(full_ds) - num_val\n","    torch.manual_seed(SEED)\n","    train_ds, val_ds = random_split(full_ds, [num_train, num_val])\n","\n","    train_dl = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=2, pin_memory=True)\n","    val_dl = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=2, pin_memory=True)\n","\n","    print(\"Imágenes totales:\", len(full_ds))\n","    print(\"Clases:\", len(full_ds.classes))\n","    print(\"Entrenamiento:\", len(train_ds), \"| Validación:\", len(val_ds))\n","    print(\"Ejemplo de clases:\", full_ds.classes[:10])\n"]},{"cell_type":"markdown","id":"1031125b","metadata":{"id":"1031125b"},"source":["\n","## 5) Entrenamiento (transfer learning)\n","Usaremos **ResNet-50** pre-entrenada y reemplazaremos la capa final para el número de clases del dataset.\n"]},{"cell_type":"code","execution_count":null,"id":"1a53f7ce","metadata":{"id":"1a53f7ce"},"outputs":[],"source":["\n","import torch\n","from torchvision import models\n","import torch.nn as nn\n","\n","device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","\n","if DATASET_PATH.strip() != \"\":\n","    base = models.resnet50(weights=models.ResNet50_Weights.DEFAULT)\n","    in_feats = base.fc.in_features\n","    base.fc = nn.Linear(in_feats, len(full_ds.classes))\n","    model = base.to(device)\n","\n","    criterion = nn.CrossEntropyLoss()\n","    optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4)\n","    epochs = 3  # Aumenta a 10-20 para resultados serios\n","    print(\"Modelo listo en\", device)\n"]},{"cell_type":"code","execution_count":null,"id":"36c0410c","metadata":{"id":"36c0410c"},"outputs":[],"source":["\n","from time import time\n","import math\n","\n","def run_epoch(dl, model, criterion, optimizer=None):\n","    is_train = optimizer is not None\n","    model.train() if is_train else model.eval()\n","    total, correct, loss_sum = 0, 0, 0.0\n","\n","    for xb, yb in dl:\n","        xb, yb = xb.to(device), yb.to(device)\n","        if is_train:\n","            optimizer.zero_grad()\n","        with torch.set_grad_enabled(is_train):\n","            out = model(xb)\n","            loss = criterion(out, yb)\n","            if is_train:\n","                loss.backward()\n","                optimizer.step()\n","        loss_sum += loss.item() * xb.size(0)\n","        preds = out.argmax(1)\n","        correct += (preds == yb).sum().item()\n","        total += xb.size(0)\n","    return loss_sum/total, correct/total\n","\n","if DATASET_PATH.strip() != \"\":\n","    best_val = 0.0\n","    for ep in range(1, epochs+1):\n","        t0 = time()\n","        tr_loss, tr_acc = run_epoch(train_dl, model, criterion, optimizer)\n","        val_loss, val_acc = run_epoch(val_dl, model, criterion, optimizer=None)\n","        dt = time() - t0\n","        print(f\"Época {ep:02d} | \"\n","              f\"train_loss {tr_loss:.4f} acc {tr_acc:.3f} | \"\n","              f\"val_loss {val_loss:.4f} acc {val_acc:.3f} | \"\n","              f\"{dt:.1f}s\")\n","\n","        if val_acc > best_val:\n","            best_val = val_acc\n","            torch.save(model.state_dict(), \"best_resnet50_turtles.pt\")\n","            print(\"✔ Guardado: best_resnet50_turtles.pt (mejora en validación)\")\n"]},{"cell_type":"markdown","id":"6bab78dc","metadata":{"id":"6bab78dc"},"source":["\n","## 6) Predicción de prueba\n","Tomamos una imagen aleatoria y mostramos la clase predicha.\n"]},{"cell_type":"code","execution_count":null,"id":"285ad63f","metadata":{"id":"285ad63f"},"outputs":[],"source":["\n","import random\n","from PIL import Image\n","import matplotlib.pyplot as plt\n","\n","if DATASET_PATH.strip() != \"\":\n","    # Cargar mejor modelo si existe\n","    if os.path.exists(\"best_resnet50_turtles.pt\"):\n","        model.load_state_dict(torch.load(\"best_resnet50_turtles.pt\", map_location=device))\n","        model.eval()\n","\n","    # Tomar una imagen al azar\n","    classes = full_ds.classes\n","    any_class = random.choice(classes)\n","    any_dir = os.path.join(DATASET_PATH, any_class)\n","    imgs = [f for f in os.listdir(any_dir) if f.lower().endswith(('.jpg','.jpeg','.png','.bmp'))]\n","    pick = os.path.join(any_dir, random.choice(imgs))\n","\n","    im = Image.open(pick).convert(\"RGB\")\n","    x = transform(im).unsqueeze(0).to(device)\n","\n","    with torch.no_grad():\n","        logits = model(x)\n","        pred = logits.argmax(1).item()\n","\n","    plt.imshow(im); plt.axis(\"off\")\n","    plt.title(f\"Predicción: {classes[pred]}\")\n","    plt.show()\n"]},{"cell_type":"markdown","source":["#*XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n","\n","\n"],"metadata":{"id":"gYI9nQdxrSsj"},"id":"gYI9nQdxrSsj"},{"cell_type":"code","source":["!pip -q install -U transformers huggingface_hub accelerate\n"],"metadata":{"id":"0dLayra1ro_d"},"id":"0dLayra1ro_d","execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["##Paso 1: AUTENTICARTE en Hugging Face (si vas a usar el LLM privado)\n","\n","Ejecuta esta celda y pega tu token cuando lo pida (no lo escribas en el código):"],"metadata":{"id":"6XtpwElcrvk9"},"id":"6XtpwElcrvk9"},{"cell_type":"code","source":["from huggingface_hub import login\n","login()  # pega tu token cuando lo pida y presiona Enter\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":17,"referenced_widgets":["a659b5929e61491ba8d790225b106ee7","e1e3cd27ea264a3a81f9cd1578137298","caa5d76c628c4aa4a8b0cd7f00c89fb5","35e81cae82794c728a66cbe4bb8e2a08","280e30a4f5c54b4f9caa25d0226de695","c5d5c3f086f2477ea5106e7b295d1f24","e30a3ff09d274ae0b86ba1b5bd54ba71","5b617d4b8ecb4e889d6ab4155f704751","740538ec418e4eee97983f9a5ccae8e8","288e3926bbc24653aa84d5753c22009a","d5722281bbea4e8ba3a3c93109b50c4d","3233d5e3874041738a472f1a83cdf5dc","d4142b1bdd7d43128f7cd0d7b09451b3","dc6660521ba64eb288ad8789fc1a2991","95745692cc4f4472900f3c806ac7200a","0aac6a998f7946fb98630e1276400056","0e3a1ab844b84981ba6994cfd6e78a3f","c6d2eafcfd1c4c4f8406aeb0b1c5a7bd","3d10e22ec3f54ab99266af36c1c35004","8a426ac483a24e1b8fb0e687757c35cc"]},"id":"7xsKYZkkpGky","executionInfo":{"status":"ok","timestamp":1758819375805,"user_tz":300,"elapsed":195,"user":{"displayName":"Luis Barahona","userId":"18006082132771143363"}},"outputId":"551a873c-396c-47f9-85bb-58ce83473cc2"},"id":"7xsKYZkkpGky","execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["VBox(children=(HTML(value='<center> <img\\nsrc=https://huggingface.co/front/assets/huggingface_logo-noborder.sv…"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"mo